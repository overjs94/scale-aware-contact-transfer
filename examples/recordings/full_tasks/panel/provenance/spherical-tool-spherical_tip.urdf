<?xml version='1.0' encoding='utf-8'?>
<robot name="shared_spherical_tool">
  <!--Authored tool. One geometry/inertia/mount source for full-scenario P contacts. TCP is the leading sphere surface, not its centre.-->
  <link name="tool_flange" />
  <link name="extension">
    <inertial>
      <origin xyz="0 0 .07" />
      <mass value=".05" />
      <inertia ixx=".00008247" iyy=".00008247" izz=".0000016" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 .07" />
      <geometry>
        <cylinder radius=".008" length=".14" />
      </geometry>
      <material name="metal">
        <color rgba=".2 .22 .25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .07" />
      <geometry>
        <cylinder radius=".008" length=".14" />
      </geometry>
    </collision>
  </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1.2500107500000001e-05" iyy="1.2500107500000001e-05" izz="1.2500107500000001e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <sphere radius=".025" />
      </geometry>
      <material name="tool">
        <color rgba=".9 .55 .2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <sphere radius=".025" />
      </geometry>
    </collision>
  </link>
  <link name="tip" />
  <joint name="extension_mount" type="fixed">
    <parent link="tool_flange" />
    <child link="extension" />
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="extension" />
    <child link="tool" />
    <origin xyz="0 0 .14" />
  </joint>
  <joint name="tip_frame" type="fixed">
    <parent link="tool" />
    <child link="tip" />
    <origin xyz="0 0 .025" />
  </joint>
</robot>